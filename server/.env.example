# MongoDB Atlas connection string (free tier is fine — no Vector Search index needed)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rag-app

# Groq API key — get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Groq model to use as the "brain"
GROQ_MODEL=llama-3.3-70b-versatile

# HuggingFace Inference API token (free) — get one at https://huggingface.co/settings/tokens
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx

# Embedding model served by HF Inference API
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

PORT=5000

# --- Auth (single operator account) ---
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=password123
# Random signing secret for session tokens — replace with a long random string in production
JWT_SECRET=replace-with-a-long-random-string
